# HELIX MCP server env — all values OPTIONAL. Defaults point at the live
# X Layer mainnet HELIX deployment, so the skill works with zero env set.
# Set these via your MCP client's `env` field, NOT via .env files at runtime.

# Override the X Layer JSON-RPC. The default is the public RPC which caps
# eth_getLogs at 100 blocks; a paid provider removes that cap.
# XLAYER_RPC_URL=https://rpc.xlayer.tech

# Point the skill at a different HELIX deployment.
# HELIX_HOOK=0x9918CDcF5a70CfA7F52D06ed9DE8fE95197450C0
# HELIX_ORACLE=0xf213fC8042136682ABd25AC2106481f4B6BdAFd2
# HELIX_POOL_MANAGER=0x360e68faccca8ca495c1B759Fd9EEe466db9FB32
# HELIX_POOL_ID=0x7e28af1b33b5a70e30ecd13e92f2d2800d59dbf1139c02e72a9a745cebdecc79
